#X floatatom 30 120 5 0 127 0 - - - 0;
#X obj 30 160 route alpha beta gamma delta epsilon zeta eta theta iota kappa;
#X text 30 200 A deliberately long comment that Pd would once have wrapped across more than one physical line when writing the file back out to disk;
#X msg 30 260 0 \, 1 \$1 \, stop;
#X obj 30 300 dac~ 1 2;
#X scalar point 40 50 12 \;;
#X obj 30 340 vsl 15 128 0 127 0 0 empty empty empty 0 -9 0 10 #0800fc #fcfcfc #000000 0 1;
